extends ../layout

mixin resolveForm(decision, resolution, errors)
  - const chosen = resolution && resolution.outcome;
  - const reflection = resolution && resolution.reflection !== undefined ? resolution.reflection : decision.reflection;
  - const outcomeError = errors && errors.outcome;
  - const outcomes = [{ value: 'right', label: 'Right' }, { value: 'wrong', label: 'Wrong' }, { value: 'unclear', label: 'Unclear' }];
  +errorSummary(errors)
  form(method='post', action=`/decisions/${decision.id}/resolve`)
    +csrfField
    fieldset#field-outcome.field(aria-describedby=outcomeError ? 'error-outcome' : false)
      legend.field__label Did it turn out as you predicted?
      .outcome-choices
        each outcome in outcomes
          label.outcome-choice(class=`outcome-choice--${outcome.value}`)
            input(type='radio', name='outcome', value=outcome.value, checked=chosen === outcome.value)
            span= outcome.label
      if outcomeError
        p.field__error#error-outcome= outcomeError
    +textarea('reflection', 'Reflection', reflection, { errors, rows: 4, hint: 'Optional. What did you miss, or get right?' })
    .form-actions
      button.btn.btn--primary(type='submit') Resolve decision

block title
  = decision.title

block content
  h1.page-title= decision.title

  .detail-meta.meta
    +decisionPill(decision)
    span Logged #{formatDate(decision.created_at)}
    span ·
    span Review #{formatDate(decision.review_on)} (#{relativeDate(decision.review_on)})
    if decision.tags.length
      span ·
      ul.tag-list(aria-label='Tags')
        each tag in decision.tags
          li.tag= tag

  blockquote.prediction.pre-line= decision.prediction
  +confidenceBar(decision.confidence).prediction-confidence

  if decision.context
    section.detail-section
      h2.detail-section__title.label Context
      p.pre-line= decision.context

  if decision.status === 'resolved'
    section.outcome-banner(class=`outcome-banner--${decision.outcome}`)
      case decision.outcome
        when 'right'
          h2.outcome-banner__title You were right.
        when 'wrong'
          h2.outcome-banner__title You were wrong.
        default
          h2.outcome-banner__title The outcome was unclear.
      p.meta Resolved #{formatDate(decision.resolved_at)}
      if decision.reflection
        p.pre-line.outcome-banner__reflection= decision.reflection
      form(method='post', action=`/decisions/${decision.id}/reopen`)
        +csrfField
        button.btn.btn--link(type='submit') Reopen
  else if decision.isDue
    section.detail-section
      h2.section__title Time to review
      +resolveForm(decision, resolution, errors)
  else
    details.disclosure.detail-section(open=Boolean(errors))
      summary Resolve early
      +resolveForm(decision, resolution, errors)

  .detail-actions.actions
    if decision.status === 'open'
      a.btn.btn--secondary(href=`/decisions/${decision.id}/edit`) Edit
    details.disclosure.disclosure--danger
      summary Delete
      p.meta This removes the decision for good.
      form(method='post', action=`/decisions/${decision.id}?_method=DELETE`)
        +csrfField
        button.btn.btn--danger(type='submit') Yes, delete this decision
